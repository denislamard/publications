# Liste blanche : tout est ignoré, sauf ce qui est explicitement autorisé.

# 1. Tout est ignoré par défaut
*

# 2. Sauf les dossiers, pour que Git puisse descendre dedans
!*/

# 3. Ce qui est publié à la racine
!.gitignore
!.nojekyll
!README.md
!LICENSE
!index.html
!*.pdf
!favicon.ico
!favicon.svg
!favicon-32.png
!apple-touch-icon.png
!icon-192.png
!icon-512.png
!site.webmanifest

# 4. Le site
!assets/css/*.css
!assets/fonts/*.woff2
!assets/fonts/LICENCES.md
!assets/img/*.svg
!assets/img/*.png
!assets/img/*.webp
!assets/img/**/*.webp

# 5. L'outillage
!outils/*.py
!outils/*.html

# 6. Jamais publiés, même s'ils tombent dans une règle ci-dessus
.venv/
__pycache__/
*.pyc
uv.lock
pyproject.toml
*.docx
.~lock.*#
images/

